{
  "author": "@polpenaloza (https://github.com/polpenaloza)",
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "commitlint": "^21.2.4",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "precise-commits": "^1.0.2",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "turbo": "^2.11.10"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": "please-use-pnpm",
    "pnpm": ">=9.x",
    "yarn": "please-use-pnpm"
  },
  "name": "react-me.com",
  "packageManager": "pnpm@10.17.1",
  "private": false,
  "repository": {
    "type": "github",
    "url": "https://github.com/polpenaloza/react-me.com.git"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "pnpm clean:dist && pnpm clean:eslint && pnpm clean:turbo && pnpm clean:node",
    "clean:dist": "npm exec --workspaces -- npx rimraf dist",
    "clean:eslint": "npm exec --workspaces -- npx rimraf .eslintcache",
    "clean:node": "npm exec --workspaces -- npx rimraf node_modules",
    "clean:turbo": "npm exec --workspaces -- npx rimraf .turbo",
    "dev:cv": "turbo run dev:cv --parallel",
    "dev:me": "turbo run dev:me --parallel",
    "format": "prettier . --write",
    "lint": "turbo run lint",
    "maintenance": "pnpm clean && pnpm install ",
    "nuke": "pnpm clean && rm pnpm-lock.yaml",
    "prepare": "husky",
    "start": "pnpm --filter @polpenaloza/me start"
  },
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "cross-spawn": "^7.0.6",
      "zod": "^4.6.6",
      "esbuild": "^0.25.0",
      "yaml": "^2.8.3"
    }
  }
}
